# ==========================================================================
# Neoda Solutions · reglas del servidor para Hostinger (Apache, public_html)
# En GitHub Pages este fichero NO se aplica: allí la protección la dan las
# metas <meta http-equiv="Content-Security-Policy"> de cada página.
# ==========================================================================

# --- Listados, firmas y ficheros de desarrollo ---------------------------
Options -Indexes -MultiViews
ServerSignature Off
IndexIgnore *

<FilesMatch "^\.">
  Require all denied
</FilesMatch>
<FilesMatch "^(package(-lock)?\.json|tailwind\.config\.js|\.htaccess|README.*\.md)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 ^/(node_modules|scripts|\.git)(/|$)

# --- Redirección 301 a HTTPS ---------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # URLs limpias: /pagina.html y /index.html pasan a /pagina/ y /
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?#] [NC]
  RewriteRule ^index\.html$ / [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+(nosotros|diagnostico|privacidad|aviso-legal|cookies)\.html[\s?#] [NC]
  RewriteRule ^(nosotros|diagnostico|privacidad|aviso-legal|cookies)\.html$ /$1/ [R=301,L]
</IfModule>

# --- Cabeceras de seguridad ----------------------------------------------
<IfModule mod_headers.c>
  # HSTS sin includeSubDomains ni preload: no afecta a subdominios (correo, etc.) y es reversible.
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
</IfModule>

# --- Caché larga solo para ficheros versionados o de terceros (fuentes y Three.js r128) ---
# Si cambian, renómbralos (p. ej. three.r129.min.js) en lugar de sobrescribirlos.
<IfModule mod_headers.c>
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^three\.r128\.min\.js$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
